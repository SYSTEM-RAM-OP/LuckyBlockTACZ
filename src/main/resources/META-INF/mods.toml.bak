[[mods]]
modId="luckyblocktacz"
version="1.0.0"
description='''
A lightweight Lucky Block add-on for TACZ.
It's not a Lucky Block add-on mod, so you don't have to include the Lucky Block mod.
Break the block to get a random gun from 70+ default TACZ firearms, along with its perfectly matched ammo.
Ready to fire, no mismatches!

这是一个基于 TACZ 的轻量级幸运方块附属模组。
这不是一个幸运方块的附加模组，所以你不需要安装幸运方块模组。
挖掉方块，即可随机获得一把包含 70+ 种默认枪械的武器，并严格附带相匹配的专属子弹，开箱即战，绝不配错！
'''
displayName="LuckyBlockTACZ"
displayURL="https://blo-g.us.ci"
credits="Special thanks to the TACZ development team for their amazing mod."
authors="SYSTEM-RAM-OP"

[[dependencies.luckyblocktacz]]
    modId="minecraft"
    mandatory=true
    versionRange="[1.20.1]"
    ordering="AFTER"
    side="BOTH"

[[dependencies.luckyblocktacz]]
    modId="tacz"
    mandatory=true
    versionRange="[1.2.0,)"
    ordering="NONE"
    side="BOTH"

