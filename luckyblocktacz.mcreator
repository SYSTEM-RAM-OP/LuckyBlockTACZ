  "workspaceSettings": {
    "modid": "luckyblocktacz",
    "modName": "LuckyBlockTACZ",
    "version": "1.0.0",
    "description": "A lightweight Lucky Block add-on for TACZ. It\u0027s not a Lucky Block add-on mod, so you don\u0027t have to include the Lucky Block mod. Break the block to get a random gun from 70+ default TACZ firearms, along with its perfectly matched ammo. Ready to fire, no mismatches!  这是一个基于 TACZ 的轻量级幸运方块附属模组。 这不是一个幸运方块的附加模组，所以你不需要安装幸运方块模组。 挖掉方块，即可随机获得一把包含 70+ 种默认枪械的武器，并严格附带相匹配的专属子弹，开箱即战，绝不配错！",
    "author": "SYSTEM-RAM-OP",
    "websiteURL": "https://blo-g.us.ci",
    "license": "All Rights Reserved",
    "serverSideOnly": false,
    "requiredMods": [
      "tacz"
    ],
    "dependencies": [],
    "dependants": [],
    "mcreatorDependencies": [],
    "currentGenerator": "forge-1.20.1",
    "credits": "Special thanks to the TACZ development team for their amazing mod.",
    "modElementsPackage": "net.mcreator.luckyblocktacz"
  },
  "mcreatorVersion": 202500345720
